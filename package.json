{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --minify --tree-shaking=true --outfile=dist/server.js",
    "start": "node dist/server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "big-integer": "^1.6.52",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/big-integer": "^0.0.30",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
