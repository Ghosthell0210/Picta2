# ==============================================================================
# PictaBot 24/7 — Plantilla de Variables de Entorno (Bot Headless en Telegram)
# Configura estos valores en el entorno de Plugged Host / Docker (nunca en Git).
# ==============================================================================

# Servidor HTTP minimo (Healthcheck + Webhook opcional)
PORT=3000
NODE_ENV=production
APP_URL=

# Administradores de Telegram
MASTER_ADMIN_CHAT_ID=
ADMIN_TELEGRAM_IDS=

# Transporte de Telegram (en Altare se recomienda "polling" 24/7)
# Valores validos: polling | webhook
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Cliente MTProto (GramJS FastSocket) para descargas de archivos grandes (hasta 2-4 GB)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_MTPROTO_SESSION=

# Afinacion MTProto y Cola para CPU compartida y disco de 10 GB en Altare
MTPROTO_SAFE_PARALLEL_WORKERS=6
MTPROTO_TCP_POOL_SIZE=6
MAX_PREFETCH_LOOKAHEAD=1

# Persistencia en Disco y Presupuesto de Almacenamiento (fuera de /tmp)
PICTA_STATE_DIR=./data/bot_state
PICTA_SCRATCH_DIR=./data/scratch
PICTA_DISK_BUDGET_GB=10

# Respaldo Cifrado en Telegram Cloud Vault (local AES-256-GCM + canal privado + setMyCommands eo/ia)
TELEGRAM_VAULT_CHAT_ID=
VAULT_ENCRYPTION_KEY=

# Integracion real con api.picta.cu / videos.picta.cu
PICTA_BASE_URL=https://videos.picta.cu
PICTA_API_BASE_URL=https://api.picta.cu
PICTA_USERNAME=
PICTA_PASSWORD=
PICTA_CLIENT_ID=
PICTA_AES_KEY=
PICTA_CHANNEL_ID=36319
PICTA_CHANNEL_NAME=Multiverso Visual
PICTA_ALERTS_INTERVAL_MS=65000
NOMAD_RETRY_INTERVAL_MS=20000

# Metadatos opcionales (TMDB / Gemini)
TMDB_API_KEY=
GEMINI_API_KEY=
